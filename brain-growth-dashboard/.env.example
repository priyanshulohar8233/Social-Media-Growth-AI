# BrainGrow - AI Social Media Assistant
# Environment Configuration

# ============================================
# Application
# ============================================
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:8080

# ============================================
# Authentication
# ============================================
# JWT secret for session tokens — REQUIRED. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRY=7d

# Google OAuth (for real Google login at /)
# Create at https://console.cloud.google.com/apis/credentials
# Redirect URI must be: <NEXT_PUBLIC_APP_URL>/api/auth/callback/google (localhost for dev, your domain in prod)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/callback/google

# ============================================
# Database
# ============================================
# Postgres is required (SQLite was replaced for Vercel/serverless deployment).
# Local dev: run Postgres locally or use a free hosted Postgres (Neon/Supabase).
#   DATABASE_URL=postgresql://user:password@host:5432/braingrow?sslmode=require

# ============================================
# Background Jobs (Vercel Cron)
# ============================================
# Vercel Cron Jobs authenticate with this secret (set in Vercel dashboard).
# Used by /api/cron/process-jobs to drain the generation job queue.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=

# Optional: shared secret for the internal /api/jobs/process endpoint
# (used by scripts/worker.mjs on non-serverless hosts).
# WORKER_KEY=

# ============================================
# File Storage (optional — for future file uploads)
# ============================================
# Media/documents are currently stored by URL reference, so no storage
# credentials are required. If you add real file uploads on Vercel, use
# Vercel Blob (https://vercel.com/docs/storage/vercel-blob):
#   BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# ============================================
# AI / LLM Providers
# ============================================
# Real providers configured — fallbacks to mock adapter when absent.
# Router chooses best provider per company modelPolicy + capability.
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# HUGGINGFACE_API_KEY=hf_...

# ============================================
# FreeLLMAPI (self-hosted LLM router)
# ============================================
# Routes to Google/Groq/OpenRouter/etc. via a single unified key.
# Get the key from your FreeLLMAPI dashboard (e.g. https://freellmapi.onrender.com/keys).
# Set FREELLMAPI_BASE_URL if self-hosting; defaults to https://freellmapi.onrender.com/v1
FREELLMAPI_API_KEY=
# FREELLMAPI_BASE_URL=https://freellmapi.onrender.com/v1

# ============================================
# Social Media APIs (when implemented)
# ============================================
# INSTAGRAM_CLIENT_ID=
# INSTAGRAM_CLIENT_SECRET=
# TWITTER_API_KEY=
# TWITTER_API_SECRET=
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=

# ============================================
# Messaging Integrations (when implemented)
# ============================================
# WHATSAPP_API_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# TELEGRAM_BOT_TOKEN=

# ============================================
# Image/Video Generation (when implemented)
# ============================================
# FAL_AI_API_KEY=
# COMFYUI_URL=http://localhost:8188

# ============================================
# Storage (when implemented)
# ============================================
# AWS_S3_BUCKET=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# LOCAL_STORAGE_PATH=./storage

# ============================================
# Security
# ============================================
# CORS_ORIGINS=http://localhost:8080
# RATE_LIMIT_MAX=100
# RATE_LIMIT_WINDOW_MS=900000

# ============================================
# Background Job Worker
# ============================================
# Secret for allowing the cron job runner to authenticate to POST /api/jobs/process
# WORKER_KEY=change-me-worker-secret

# ============================================
# Logging
# ============================================
LOG_LEVEL=info
